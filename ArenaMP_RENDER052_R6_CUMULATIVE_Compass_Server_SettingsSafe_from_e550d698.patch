+fragment main {
+
+    omw_In vec2 omw_TexCoord;
+
+    void main()
+    {
+        vec4 color = omw_GetLastShader(omw_TexCoord);
+        color.rgb = (color.rgb - vec3(0.5)) * uContrast + 0.5;
+        color.rgb = pow(color.rgb, vec3(1.0 / uGamma));
+
+        omw_FragColor = color;
+    }
+}
+
+technique {
+    description = "#{OMWShaders:AdjustmentsDescription}";
+    version = "1.0";
+    author = "OpenMW";
+    passes = main;
+}
